        <mxCell id="c32" value="canalización" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c15" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c33" value="imagen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c13" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;Por qué spot.&lt;/b&gt; Una instancia spot puede ser expropiada sin aviso. Si el runner persiste cada documento al terminarlo, una expropiación cuesta &lt;b&gt;un documento, no seis horas&lt;/b&gt;. Y las filas por documento ya hacen falta para los tests pareados del ADR-000." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1465" y="330" width="295" height="128" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;Verificar antes de empezar.&lt;/b&gt; Cuota de GPU en la cuenta (el periodo de prueba no la trae), disponibilidad de L4 en la región, y &lt;b&gt;alerta de presupuesto&lt;/b&gt; activa." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDECEA;strokeColor=#C5221F;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1465" y="472" width="295" height="104" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;Cloud Storage + BigQuery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;resultados y métricas agregadas&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E6F0FD;strokeColor=#1A73E8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="662" width="250" height="82" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;b&gt;Análisis estadístico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;tests pareados n=300&lt;br&gt;ROUGE · BERTScore · costo&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="662" width="250" height="82" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;Criterio calidad/costo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;objetivo específico 6&lt;br&gt;elige 1 de 8 configuraciones&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="662" width="265" height="82" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;CONFIGURACIÓN GANADORA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;model + strategy + params&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="662" width="280" height="82" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;paper/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;informe final&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1385" y="662" width="225" height="82" as="geometry"/></mxCell>
