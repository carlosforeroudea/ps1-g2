        <mxCell id="c51" value="despliega config ganadora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#1E8E3E;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c32" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;b&gt;Limitación medida.&lt;/b&gt; En CPU, map-reduce sobre el artículo mediano son &lt;b&gt;7 pasadas&lt;/b&gt; de BART (19 en el p95, 108 en el peor caso): del orden de minutos por documento. Además el Space &lt;b&gt;se duerme tras 48 h&lt;/b&gt; de inactividad y el primer arranque tarda. Aceptable para una demostración pactada, no para uso abierto." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDECEA;strokeColor=#C5221F;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1230" y="950" width="500" height="76" as="geometry"/></mxCell>
        <mxCell id="c53" value="Amarillo = Hugging Face · Azul = Google Cloud · Verde = artefacto que cierra el ciclo MLOps · Borde rojo punteado = limitación medida" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7A8699;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1080" width="1700" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="esc2" name="Escenario 2 · ZeroGPU (RECOMENDADO)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Escenario 2 · Costo cero con GPU bajo demanda — HF Spaces ZeroGPU" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#1F2733;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Misma factura que el escenario 1, pero la inferencia corre en GPU asignada por invocación. Recomendado: resuelve la latencia sin introducir costo." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="54" width="1250" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="COSTO: 0 USD&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ZeroGPU · cuota gratuita por cuenta&lt;/font&gt;" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E8E3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="26" width="350" height="52" as="geometry"/></mxCell>
