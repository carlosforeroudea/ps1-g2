        <mxCell id="c50" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;navegador&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="898" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;b&gt;HF Space · Gradio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;UI + cola de trabajos&lt;br&gt;CPU basic — GRATIS&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF6D6;strokeColor=#C99A10;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="258" y="866" width="235" height="144" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;b&gt;Cola de trabajos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;ticket por documento&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="533" y="854" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;Worker asíncrono&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;src/resumidor&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="533" y="952" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;ZeroGPU  @spaces.GPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;GPU asignada solo&lt;br&gt;durante la generación&lt;br&gt;0 USD&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="882" width="245" height="120" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;b&gt;HF Dataset — trabajos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;estado y resumen&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF6D6;strokeColor=#C99A10;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065" y="854" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;b&gt;HF Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;pesos del modelo ganador&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF6D6;strokeColor=#C99A10;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065" y="952" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="c57" value="sube artículo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c58" value="encola → ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c60" value="invoca" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c62" value="carga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c56" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c63" value="sondeo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c64" value="despliega la configuración ganadora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#1E8E3E;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c43" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;Por qué aquí no se paga.&lt;/b&gt; A la plataforma nadie le audita la reproducibilidad: solo tiene que estar arriba el día de la sustentación. ZeroGPU da el mismo resultado visible por 0 USD, y Spaces es una plataforma de despliegue legítima, no un juguete." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1340" y="854" width="420" height="112" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;Cola, no petición-respuesta.&lt;/b&gt; Map-reduce necesita 7 pasadas del modelo en el artículo mediano, 19 en el p95 y 108 en el peor caso (EDA 02). Sin cola habría que sacar map-reduce de la plataforma y se rompería el ADR-001." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDECEA;strokeColor=#C5221F;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1340" y="980" width="420" height="96" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;uv.lock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;versiones exactas&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1152" width="195" height="62" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;imagen @sha256&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;entorno exacto&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E6F0FD;strokeColor=#1A73E8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="1152" width="205" height="62" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;config.yaml + semilla 42&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;muestra exacta&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="1152" width="225" height="62" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;resultado por documento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;300 filas × configuración&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A8699;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1152" width="225" height="62" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;b&gt;tests pareados auditables&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6472&quot;&gt;ADR-000&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1152" width="235" height="62" as="geometry"/></mxCell>
        <mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c69" target="c70"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c70" target="c71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c76" value="Esta cadena es lo que un cuaderno de Colab &lt;b&gt;no&lt;/b&gt; puede entregar: allí el entorno lo fija el proveedor cada mañana. Es la razón de gastar los ~10 USD, y no tiene nada que ver con ir más rápido." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1350" y="1140" width="410" height="86" as="geometry"/></mxCell>
        <mxCell id="c77" value="Amarillo = Hugging Face · Azul = Google Cloud · Verde = decisión de diseño o artefacto que cierra el ciclo · Rojo punteado = verificar antes de empezar" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7A8699;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1252" width="1700" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
