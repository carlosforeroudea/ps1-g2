        <mxCell id="c1" value="Escenario 3 · GCP con escala a cero — el más profesional" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#1F2733;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Contenedores, IaC y CI/CD reales. En reposo no cobra nada; solo se enciende durante la demostración. Es el escenario que mejor se sustenta." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="54" width="1250" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="COSTO: ≈0 USD en reposo&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;min-instances=0 · pocos USD por demo con GPU&lt;/font&gt;" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E8E3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="26" width="350" height="52" as="geometry"/></mxCell>
