        <mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c51" value="carga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c45" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c52" value="sondeo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#5A6472;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c53" value="despliega config ganadora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#1E8E3E;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3C4653;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c32" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;Por qué éste.&lt;/b&gt; Con GPU, las 7 pasadas de map-reduce bajan de minutos a decenas de segundos. La cola sigue siendo necesaria para el p95 (19 pasadas) y para el peor caso (108)." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1450" y="790" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;b&gt;Limitación.&lt;/b&gt; ZeroGPU tiene &lt;b&gt;cuota por cuenta&lt;/b&gt; y arranque en frío; la cuota vigente hay que verificarla antes de la demostración. Dependencia de un solo proveedor: si HF cambia el plan gratuito, el despliegue cae. El escenario 3 es el plan B." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDECEA;strokeColor=#C5221F;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1450" y="906" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c56" value="Amarillo = Hugging Face · Azul = Google Cloud · Verde = artefacto que cierra el ciclo MLOps · Borde rojo punteado = limitación medida" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7A8699;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1080" width="1700" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="esc3" name="Escenario 3 · GCP escala a cero">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
