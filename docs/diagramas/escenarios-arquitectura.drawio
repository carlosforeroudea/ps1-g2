        <mxCell id="c31" value="&lt;b&gt;Alternativa sin costo:&lt;/b&gt; el factorial también cabe en Colab/Kaggle gratis (escenarios 1-2). Cloud Run Job se usa solo si se quiere la corrida reproducible en contenedor." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383F;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="360" y="476" width="560" height="40" as="geometry"/></mxCell>
